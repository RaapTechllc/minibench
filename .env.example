# MiniBench — copy to .env and fill in values
#   cp .env.example .env

# ─── OpenRouter (agent benchmarks) ───────────────────────────────────────────
# Get a key at https://openrouter.ai/keys
# Used by agentbench for MoA runs, model catalog polling, and Mode A Data API
# poll (GET /models, /datasets/rankings-daily, /benchmarks, /classifications/task).
# Prefer a Data-API-only key for any poller; never put an inference key on a
# public recommend server. Recommend binds 127.0.0.1 only.
OPENROUTER_API_KEY=

# Runtime path to a live joined Usage Board snapshot (off the git tree).
# Unset or missing file → committed fixture, never labelled live.
# Do not commit a value or a live snapshot.
OPENROUTER_BOARD_PATH=

# Optional: Ollama Cloud (alternative provider for agentbench)
# OLLAMA_API_KEY=

# ─── Backend (FastAPI + PostgreSQL) ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://minibench:minibench@localhost:5438/minibench
DATABASE_URL_SYNC=postgresql+psycopg2://minibench:minibench@localhost:5438/minibench

# ─── CLI ─────────────────────────────────────────────────────────────────────
MINIBENCH_API_URL=http://localhost:3070
